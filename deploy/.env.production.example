DOMAIN=example.com
PROJECT_NAME=Osushenie Control
ENVIRONMENT=production

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=https://example.com
UPLOAD_DIR=uploads
MAX_PHOTO_SIZE_BYTES=5242880

POSTGRES_DB=osushenie_control
POSTGRES_USER=osushenie_app
POSTGRES_PASSWORD=replace-with-a-long-unique-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://osushenie_app:replace-with-a-long-unique-password@db:5432/osushenie_control

AI_API_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=60

SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_PATH=/api/v1/auth
REFRESH_TOKEN_COOKIE_SECURE=true
REFRESH_TOKEN_COOKIE_SAMESITE=lax
